<ScriptCode StartSel="227" SelLength="0" OutStatusBar="1" OutLog="1" OutPrinter="1">Public Sub SymbolLoading()
	bDay = Format(Now, "ddd")
	bMonth = Format(Now, "mmm")
End Sub

Public Sub On_SysVar__ActTimeDayChanged(ByRef value As Variant)
	bDay = Format(Now, "ddd")
	bMonth = Format(Now, "mmm")
End Sub
</ScriptCode>
